# Optional credentials only. Core offline cancer workflow needs no keys.
# Copy to .env; never commit real credentials.

# Modal embedding script (or authenticate with Modal CLI).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Boltz CLI uses its own OAuth login. Per-call cap for --boltz:
VN_BOLTZ_MAX_USD=0.25

# Wild-type catalog controls only; mutant screening is unsupported.
PTARMIGAN_API_KEY=

# Reserved integrations; setting these keys does not implement the adapters.
KEENABLE_API_KEY=
NEBIUS_API_KEY=
GENOMICS_INTELLIGENCE_API_KEY=
ONCOKB_API_TOKEN=
NCBI_API_KEY=
