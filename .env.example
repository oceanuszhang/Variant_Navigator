# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Critical path: Steps 4 and 5 cannot run without these ---

# Ptarmigan-1 drug binding screen (Talus Bio) — Step 4
PTARMIGAN_API_KEY=

# Keenable report agent — Step 5
KEENABLE_API_KEY=

# --- Compute backend: Steps 2 and 3 (ESM2 + Boltz) ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Nebius: report-writing agent, Step 7 ---
# Optional. Without it agent_report.py uses its deterministic markdown
# renderer, which already produces a complete report.
NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
# NEBIUS_MODEL=

# --- Boltz: structure prediction, Step 4 ---
# The boltz-api CLI uses device-code auth and stores its own credentials, so
# this is only needed if you call the HTTP API directly.
BOLTZ_API_KEY=

# --- Genomics Intelligence API ---
# Ground-truth cross-referencing (evidence track, Step 5). Leave blank here and
# put the real value in .env - .env.example is COMMITTED.
GENOMICS_INTELLIGENCE_API_KEY=
# GENOMICS_INTELLIGENCE_BASE_URL=
# GENOMICS_INTELLIGENCE_ORG_ID=

# --- Optional: ground-truth cross-referencing in Step 5 ---

# OncoKB REST API (cancer drug-variant sensitivity levels)
ONCOKB_API_TOKEN=

# NCBI E-utilities for ClinVar. Works without a key at a lower rate limit.
NCBI_API_KEY=

# No key required: UniProt, PubChem, CARD (bulk download), FRAC (manual tables)
